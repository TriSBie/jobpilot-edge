# JobPilot Edge — API Worker (vanilla JS, apps/api/src/worker.js) — wrangler config mẫu
# Copy thành wrangler.toml sau khi tạo tài nguyên ở Phase 0 và điền các ID thật.
# TUYỆT ĐỐI không commit wrangler.toml đã điền ID/secret lên repo public.

name = "jobpilot-api"
main = "src/worker.js"
compatibility_date = "2026-10-01"
workers_dev = true

# Cron: quét nguồn job mỗi 30 phút + dọn dẹp 01:00 UTC + backup D1→R2 18:00 UTC (01:00 VN)
[triggers]
crons = ["*/30 * * * *", "0 1 * * *", "0 18 * * *"]

[vars]
APP_ENV = "production"
DIGEST_HOUR_LOCAL = "7"
TELEGRAM_BOT_USERNAME = "your_bot"
# "1" mới bật cron tự đóng đơn im lặng 14 ngày (ghi lên dữ liệu người dùng); mặc định tắt
AUTO_CLOSE_ENABLED = "0"
# Secret: xem danh sách cuối file.

# --- D1 (database chính) ---
[[d1_databases]]
binding = "DB"
database_name = "jobpilot"
database_id = "<D1_DATABASE_ID>"

# --- KV (cache / session / quota counters) ---
[[kv_namespaces]]
binding = "KV"
id = "<KV_NAMESPACE_ID>"

# --- R2 (CV, cover letter, snapshot JD) ---
[[r2_buckets]]
binding = "FILES"
bucket_name = "jobpilot-files"

# --- Queues: ingest / score / notify ---
# DLQ: tạo trước khi deploy (`wrangler queues create jobpilot-<tên>-dlq`). Message lỗi quá
# max_retries lần được chuyển sang DLQ, không tự xử lý lại — phải xem rồi replay tay.
[[queues.producers]]
binding = "Q_INGEST"
queue = "jobpilot-ingest"

[[queues.producers]]
binding = "Q_SCORE"
queue = "jobpilot-score"

[[queues.producers]]
binding = "Q_NOTIFY"
queue = "jobpilot-notify"

[[queues.consumers]]
queue = "jobpilot-ingest"
max_batch_size = 10
max_retries = 3
dead_letter_queue = "jobpilot-ingest-dlq"

[[queues.consumers]]
queue = "jobpilot-score"
max_batch_size = 10
max_retries = 3
dead_letter_queue = "jobpilot-score-dlq"

[[queues.consumers]]
queue = "jobpilot-notify"
max_batch_size = 10
# Telegram/digest lỗi tạm hay gặp hơn → thử nhiều hơn (anh chốt 06/11/2026)
max_retries = 5
dead_letter_queue = "jobpilot-notify-dlq"

# --- Durable Objects: hub realtime theo user ---
[durable_objects]
bindings = [{ name = "USER_HUB", class_name = "UserHub" }]

[[migrations]]
tag = "v1"
new_sqlite_classes = ["UserHub"]

# --- Workers AI + AI Gateway (mọi call AI đi qua gateway "jobpilot") ---
[ai]
binding = "AI"

# --- Vectorize: embedding CV/JD (768 chiều — khớp model bge-base) ---
[[vectorize]]
binding = "EMB"
index_name = "jobpilot-emb"

# --- Analytics Engine: event sản phẩm ---
[[analytics_engine_datasets]]
binding = "EVENTS"
dataset = "jobpilot_events"

# --- Hyperdrive (Phase 1): đọc Neon Postgres của Job Watcher cũ để migrate ---
# [[hyperdrive]]
# binding = "LEGACY_DB"
# id = "<HYPERDRIVE_CONFIG_ID>"

# --- Browser Run (Phase 2): fallback đọc JD cần JS ---
# [browser]
# binding = "BROWSER"

# Secrets (đặt bằng `wrangler secret put`, không ghi ở đây):
# - TELEGRAM_BOT_TOKEN
# - TELEGRAM_WEBHOOK_SECRET
# - TURNSTILE_SECRET (thiếu thì bỏ qua kiểm Turnstile, chỉ cho lab/dev)
# Biến tuỳ chọn chỉ dùng ở lab (không đặt ở production):
# - TELEGRAM_API_BASE (mặc định https://api.telegram.org)
# - TELEGRAM_QUIET_OVERRIDE ("1" = bỏ giờ yên lặng)
